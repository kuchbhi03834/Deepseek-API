# Copy this file to .env. Sign-in is done by hand in a browser window
# (run `python -m deepseek.auth`), so no credentials are stored here.

# --- Server & Network ---
# HOST=127.0.0.1
# PORT=8000
# RATE_LIMIT_PER_MINUTE=60               # per-client-IP limit on API endpoints
# API_KEY=                               # Optional Bearer token for client authentication

# --- Session & Authentication ---
# DEEPSEEK_PROFILE_DIR=session/profile   # Reuse an existing signed-in Chrome profile
# SERVER_INTERACTIVE_LOGIN=1             # 1 = open browser on first login, 0 = return 503 headless

# --- Concurrency & Proof-of-Work Queue ---
# POW_WORKERS=4                          # Number of parallel PoW wasm solver workers
# POW_SOLVE_TIMEOUT=25.0                 # Seconds to wait for PoW challenge solver before timeout
# UPSTREAM_RETRY_AFTER=30                # Seconds advertised in Retry-After header on upstream rate limit

# --- Diagnostics ---
# DEBUG_REQUESTS=0                       # 1 = log detailed tool calling & role debug info
